     "line_end": {
      "type": "integer"
     },
     "event_id": {
      "type": "string"
     },
     "quote": {
      "type": "string"
     },
     "supports": {
      "type": "string"
     }
    },
    "required": [
     "id",
     "path",
     "line_start",
     "line_end",
     "event_id",
     "quote",
     "supports"
    ],
    "additionalProperties": false
   }
  },
  "limitations": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "case_evidence_ids": {
   "type": "array",
   "items": {
    "type": "string"
   }
  }
 },
 "required": [
  "schema_version",
  "task",
  "outcome",
  "headline",
  "requirements",
  "stage_summary",
  "delivery_audit",
  "workplace_findings",
  "blind_review_revisions",
  "case_paragraph",
  "evidence",
  "limitations",
  "case_evidence_ids"
 ],
 "additionalProperties": false
}